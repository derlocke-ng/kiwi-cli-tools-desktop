#!/usr/bin/env python3
"""pweb — serve the current directory over HTTPS on a random free port.

Zero configuration: a self-signed certificate is generated on first run and
reused afterwards. Meant for quickly handing a file to another machine on the
same network — it serves to the whole LAN, so start it in the directory you
mean to share and nowhere wider."""
import http.server
import os
import shutil
import socket
import ssl
import subprocess
import sys


def find_free_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("", 0))
        return s.getsockname()[1]


def self_signed_cert():
    d = os.path.join(os.environ.get("XDG_DATA_HOME",
                                    os.path.expanduser("~/.local/share")), "pweb")
    os.makedirs(d, exist_ok=True)
    cert, key = os.path.join(d, "cert.pem"), os.path.join(d, "key.pem")
    if not (os.path.exists(cert) and os.path.exists(key)):
        if not shutil.which("openssl"):
            sys.exit("pweb: openssl is required to create the certificate")
        # subprocess with list args, not os.system with an f-string: a HOME
        # with a space broke the command, and the key was left world-readable
        subprocess.run(["openssl", "req", "-x509", "-newkey", "rsa:4096",
                        "-keyout", key, "-out", cert, "-days", "365",
                        "-nodes", "-subj", "/CN=localhost"],
                       check=True, stderr=subprocess.DEVNULL)
        os.chmod(key, 0o600)
    return cert, key


def main():
    port = find_free_port()
    cert, key = self_signed_cert()
    host = socket.gethostname()
    # flush: piped or logged, these lines are the whole point of the tool,
    # and block buffering held them back until the server exited
    print(f"serving {os.getcwd()}", flush=True)
    print(f"on https://{host}:{port}  (also https://localhost:{port})", flush=True)
    print("self-signed certificate — the browser warns once. Ctrl+C stops it.",
          flush=True)
    httpd = http.server.HTTPServer(("0.0.0.0", port),
                                   http.server.SimpleHTTPRequestHandler)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(certfile=cert, keyfile=key)
    httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")


if __name__ == "__main__":
    main()
