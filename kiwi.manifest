LICENSE=GPL-3.0-or-later

COMPONENTS=cli
CATEGORY=Network
TAGS=https share ssh tethering ttl terminal

SCOPES=user

DEPENDS=python3 openssl ssh ip iptables

INSTALLER=install.sh
